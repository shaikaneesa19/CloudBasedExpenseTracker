# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security Keys (Generate strong keys for production!)
SECRET_KEY=your-super-secret-key-change-this-for-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-for-production
JWT_EXPIRY_HOURS=24

# Database Configuration
# Local SQLite (default):
# Leave DATABASE_URL blank or commented for SQLite
DATABASE_URL=sqlite:///expense_tracker.db

# AWS RDS PostgreSQL / MySQL Example:
# DATABASE_URL=postgresql://dbuser:dbpassword@rds-endpoint.amazonaws.com:5432/expensetracker

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
